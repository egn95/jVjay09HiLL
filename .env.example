# Salin file ini ke .env dan sesuaikan nilainya
PORT=3000
NODE_ENV=production
JWT_SECRET=ganti-dengan-kunci-rahasia-yang-kuat-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-kunci-refresh-yang-berbeda-minimal-32-karakter
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGIN=http://localhost:3000
BACKUP_RETENTION_DAYS=30

# ── Backup PostgreSQL (pg_dump) ────────────────────
# Path ke pg_dump/psql jika tidak ada di PATH sistem
# Linux default: /usr/bin/pg_dump  |  Windows: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql

# ── Backup Cloud Storage (opsional — S3-compatible) ─
# Kosongkan BACKUP_S3_BUCKET untuk menonaktifkan upload cloud
# Kompatibel dengan: AWS S3, Cloudflare R2, Backblaze B2, MinIO
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto

# ── Database PostgreSQL ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=akta_iat
DB_USER=postgres
DB_PASSWORD=ganti-dengan-password-postgres
# DB_SSL=true  # Aktifkan untuk koneksi SSL (misalnya Supabase, Railway, Render)

# ── Notifikasi Email (SMTP) ────────────────────────
# Kosongkan SMTP_HOST untuk menonaktifkan notifikasi email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=false  # Set true hanya jika port 465 (SSL)
SMTP_USER=email@gmail.com
# Untuk Gmail: gunakan App Password (bukan password biasa)
# Aktifkan di: myaccount.google.com/apppasswords
SMTP_PASS=app-password-16-digit
SMTP_FROM=AKTA IAT <noreply@domain.com>

# Penerima alert sistem (backup report, login gagal 5x, dsb)
ADMIN_EMAIL=admin@perusahaan.com
# Penerima notifikasi operasional harian (backward compat)
NOTIFY_EMAIL_ADMIN=admin@perusahaan.com

# URL aplikasi — digunakan di link tombol dalam email
APP_URL=https://yourdomain.com
